# Exemplo de ambiente do viralizai. SÓ NOMES: os valores ficam no Infisical (rt-produtos/viralizai, ambiente prod) e chegam à VPS no deploy. Nunca commitar valores.
# Em desenvolvimento local basta copiar para .env e preencher o que for usar; sem SMTP/LLM o app roda em modo de desenvolvimento.

SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=
SMTP_USER=
VIRALIZAI_ADMIN_KEY=
VIRALIZAI_CAKTO_SEGREDO=
VIRALIZAI_CHECKOUTS=
VIRALIZAI_DEMO_SENHA=
VIRALIZAI_LLM_KEY=
VIRALIZAI_PIXABAY_KEY=
VIRALIZAI_PLANOS_CAKTO=
VIRALIZAI_PN_TOKEN=
VIRALIZAI_SEGREDO_SESSAO=
VIRALIZAI_SMTP_FROM=
